<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <set android:ordering="together">
            <objectAnimator android:propertyName="scaleX" android:valueTo="0.985" android:valueType="floatType" android:duration="75" />
            <objectAnimator android:propertyName="scaleY" android:valueTo="0.985" android:valueType="floatType" android:duration="75" />
            <objectAnimator android:propertyName="rotationX" android:valueTo="2" android:valueType="floatType" android:duration="75" />
        </set>
    </item>
    <item>
        <set android:ordering="together">
            <objectAnimator android:propertyName="scaleX" android:valueTo="1" android:valueType="floatType" android:duration="160" />
            <objectAnimator android:propertyName="scaleY" android:valueTo="1" android:valueType="floatType" android:duration="160" />
            <objectAnimator android:propertyName="rotationX" android:valueTo="0" android:valueType="floatType" android:duration="160" />
        </set>
    </item>
</selector>
