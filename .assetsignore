# Never publish development, administration or backend files as Worker assets.
/.git
/.github/
/.wrangler/
/node_modules/
/.npm-cache/
/android-studio/
/supabase/
/tests/
/tools/
/docs/
/reports/
/ops/
/integrations/
/artifacts/
/.gitignore
/.vercelignore
/.assetsignore
/wrangler.jsonc
/wrangler.json
/wrangler.toml
/vercel.json
/package.json
/package-lock.json
/audit-results.json
/search-audit-results.json
/*.md
**/.env*
**/.dev.vars*
**/*.log
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.jks
**/*.keystore
**/*.aab
**/*.apk
**/*.zip
